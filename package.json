  "description": "A CommonJS WhatsApp Web API library — CJS conversion of official @whiskeysockets/baileys v7 with an added anti-ban toolkit",
  "keywords": [
    "whatsapp",
    "baileys",
    "whatsapp-web",
    "automation",
    "commonjs"
  ],
  "homepage": "https://github.com/phimst/bailx",
  "repository": {
    "type": "git",
    "url": "https://github.com/phimst/bailx.git"
  },
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
