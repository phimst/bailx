    "protobufjs": "^7.5.6",
    "whatsapp-rust-bridge": "0.5.5",
    "ws": "^8.18.2"
  },
  "peerDependencies": {
    "audio-decode": "^2.1.3",
    "jimp": ">=0.16.0",
    "link-preview-js": "^3.0.0",
    "sharp": "*"
